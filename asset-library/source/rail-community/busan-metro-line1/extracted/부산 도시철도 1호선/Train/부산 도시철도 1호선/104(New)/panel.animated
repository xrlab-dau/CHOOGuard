[object]
states = 3dcab\needle_speedometer.csv
position = -0.102, 2.154, 9.595
rotatezdirection = 0, 0, -1
rotatezfunction = abs[speedometer] * 0.125663706143592

;브레이크

[object]
states = 3dcab\brake_lever.csv
position = 0.31, 1.9735, 9.25
rotateyfunction = (brakeNotchLinear / brakeNotchesLinear) * 1.5 - 1.5
rotateydirection = 0, -1, 0
rotateydamping = 20, 0.8

;역전기

[object]
states = 3dcab\reveser_lever.csv
position = -0.5, 1.973, 9.38
rotateyfunction = 0.95 * reverserNotch 
