rotateydamping = 20, 0.8

[object]
states = 3dcab\power_mount.csv
position = -0.61, 1.973, 9.272
rotateyfunction = ((powerNotch / powerNotches) * 13 - 1) * 0.12
rotateydirection = 0, 1, 0
rotateydamping = 20, 0.8

