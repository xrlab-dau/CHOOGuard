# choo guard 기술 조사 하네스 환경 변수 예시.
# 실제 값은 이 파일에 쓰지 말고 셸 환경 또는 로컬 .env(커밋 금지)에 둔다.
# 이 하네스에는 PUBLIC_SYNTHETIC 등급의 공개 기술 주제만 입력한다.
# 철도 촬영 자료, 재구성 지오메트리, KORAIL 내부 자료, 얼굴·차량번호·자격 정보는 절대 입력하지 않는다.

# Exa 검색 (필수). https://dashboard.exa.ai 에서 발급.
EXA_API_KEY=

# 조사 에이전트가 사용할 LLM 제공자 키 (둘 중 하나 이상).
# RESEARCH_MODEL 기본값은 anthropic:claude-sonnet-5 이다. 검토용 교차 조사에는 openai:gpt-5.6-sol 을 쓴다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEARCH_MODEL=anthropic:claude-sonnet-5
