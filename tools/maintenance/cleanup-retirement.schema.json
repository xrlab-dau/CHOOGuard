{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHOOGuard immutable cleanup retirement manifest",
  "type": "object",
  "required": ["schema_version", "manifest_id", "approved_by", "approved_at", "project_root", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "approved_by": {"const": "root"},
    "approved_at": {"type": "string", "format": "date-time"},
    "project_root": {"type": "string", "pattern": "^/"},
    "entries": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["path", "category", "reason", "retire_after", "quiet_seconds", "fingerprint"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "category": {"enum": ["retired_artifact", "expired_temp"]},
          "reason": {"type": "string", "minLength": 1},
          "retire_after": {"type": "string", "format": "date-time"},
          "quiet_seconds": {"type": "integer", "minimum": 3600},
          "fingerprint": {
            "type": "object", "additionalProperties": false,
            "required": ["device", "inode", "size", "mtime_ns"],
            "properties": {
              "device": {"type": "integer", "minimum": 0},
              "inode": {"type": "integer", "minimum": 0},
              "size": {"type": "integer", "minimum": 0},
              "mtime_ns": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
