  m_Script: {fileID: 11500000, guid: 50b755bbeb195084f899e28c50b910cc, type: 3}
  m_Name: CrewInspectionPlan
  m_EditorClassIdentifier: ChooGuard.App::ChooGuard.App.Fps.Tutorial.CrewInspectionPlan
  Steps:
  - Chapter: "\uD1B5\uC2E0 \uC810\uAC80"
    Title: "\uBB34\uC804\uAE30 \uC804\uC6D0\xB7\uBC30\uD130\uB9AC \uD655\uC778"
    Instruction: "\uBB34\uC804\uAE30\uB97C \uBC14\uB77C\uBCF4\uACE0 E\uB97C \uB204\uB974\uC138\uC694.\n\uC601\uC0C1\uC5D0\uC11C\uCC98\uB7FC
      \uADFC\uBB34 \uC804 \uBB34\uC804\uAE30\uC758 \uC804\uC6D0\uACFC \uBC30\uD130\uB9AC\uB97C
      \uD655\uC778\uD569\uB2C8\uB2E4."
    Result: "\uBB34\uC804\uAE30 \uC804\uC6D0\uACFC \uBC30\uD130\uB9AC\uB97C \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.\n\uBC29\uC1A1
      \uCD9C\uB825\uACFC \uBE44\uC0C1\uD1B5\uD654 \uC778\uD130\uD3F0\uC740 \uAC01\uAC01\uC758
      \uC7A5\uBE44\uC5D0\uC11C \uC810\uAC80\uD569\uB2C8\uB2E4."
    TargetId: radio
    Action: 0
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: c80b6370d49d59d438f894f655720302, type: 3}
    ResponseVoice: {fileID: 0}
    Observation: "\uC804\uC6D0 \uCF1C\uC9D0 \xB7 \uBC30\uD130\uB9AC 85%\n\uADFC\uBB34
      \uC804 \uBB34\uC804\uAE30 \uC900\uBE44"
  - Chapter: "\uD1B5\uC2E0 \uC810\uAC80"
    Title: "\uC810\uAC80\uC6A9 \uBC29\uC1A1 \uD655\uC778"
    Instruction: "\uC2A4\uD53C\uCEE4 \uD45C\uC2DD\uC5D0\uC11C E\uB97C \uB204\uB974\uC138\uC694.\n\uAD50\uC721\uC6A9
      \uC2DC\uD5D8 \uBC29\uC1A1\uC774 \uAC1D\uC2E4 \uC2A4\uD53C\uCEE4\uC5D0\uC11C
      \uB098\uC624\uB294\uC9C0 \uB4E3\uACE0 \uD655\uC778\uD569\uB2C8\uB2E4. \uBC29\uC1A1\uC774
      \uB05D\uB09C \uB4A4 \uC778\uD130\uD3F0 \uC810\uAC80\uC73C\uB85C \uC774\uC5B4\uAC11\uB2C8\uB2E4."
    Result: "\uC2DC\uD5D8 \uBC29\uC1A1 \uCD9C\uB825\uC744 \uD655\uC778\uD588\uACE0
      \uBC29\uC1A1\uC774 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\n\uC774\uC81C \uAC1D\uC2E4\uC758
      \uBE44\uC0C1\uD1B5\uD654 \uC778\uD130\uD3F0\uC744 \uC2DC\uD5D8\uD569\uB2C8\uB2E4."
    TargetId: pa
    Action: 2
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: 34a65e2b18c06114cb4cf5be62fd44be, type: 3}
    ResponseVoice: {fileID: 8300000, guid: 6aaabc9a2f923354e8a706f17f9b8a5e, type: 3}
    Observation: "\uAC1D\uC2E4 \uC2A4\uD53C\uCEE4\uC758 \uC2E4\uC81C \uC74C\uC131\n\uBC29\uC1A1
      \uC885\uB8CC \uD6C4 \uC778\uD130\uD3F0 \uC2DC\uD5D8"
  - Chapter: "\uD1B5\uC2E0 \uC810\uAC80"
    Title: "\uBE44\uC0C1\uD1B5\uD654 \uC778\uD130\uD3F0 \uC2DC\uD5D8"
    Instruction: "\uCD9C\uC785\uBB38 \uC606 \uD638\uCD9C \uBC84\uD2BC\uC774 \uC788\uB294
      \uC778\uD130\uD3F0 \uD328\uB110\uC744 \uBC14\uB77C\uBCF4\uACE0 E\uB97C \uB204\uB974\uC138\uC694.\n\uD638\uCD9C\uC74C\uC744
      \uB4E3\uACE0 \u2018\uBE44\uC0C1\uD1B5\uD654 \uC810\uAC80 \uC911\uC785\uB2C8\uB2E4\u2019\uB77C\uACE0
      \uC804\uB2EC\uD55C \uB4A4 \uC0C1\uB300\uC758 \uC751\uB2F5\uC744 \uD655\uC778\uD569\uB2C8\uB2E4."
    Result: "\uD638\uCD9C\uC74C\uACFC \uC778\uD130\uD3F0\uC758 \uC810\uAC80 \uD1B5\uD654\xB7\uC751\uB2F5\uC744
      \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.\n\uC601\uC0C1\uCC98\uB7FC \uC2B9\uAC1D\uC774
      \uAC1D\uC2E4\uC5D0\uC11C \uC2B9\uBB34\uC6D0\uC744 \uD638\uCD9C\uD558\uB294
      \uC7A5\uBE44\uB97C \uC2DC\uD5D8\uD588\uC2B5\uB2C8\uB2E4."
    TargetId: intercom
    Action: 1
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: 1d22dbafb88a51f45b273d19907eb1c9, type: 3}
    ResponseVoice: {fileID: 8300000, guid: 45f3dd8cedaa1284097a2589c3910493, type: 3}
    Observation: "\uAE30\uC874 \uBE44\uC0C1\uD1B5\uD654 \uC778\uD130\uD3F0\n\uD638\uCD9C\uC74C
      \u2192 \uC810\uAC80 \uD1B5\uD654 \u2192 \uC751\uB2F5"
  - Chapter: "\uC548\uC804 \uC7A5\uBE44"
    Title: "\uC18C\uD654\uAE30 \uC704\uCE58\xB7\uC678\uAD00 \uD655\uC778"
    Instruction: "\uC18C\uD654\uAE30 \uC218\uB0A9\uD568\uC5D0\uC11C E\uB97C \uB204\uB974\uC138\uC694.\n\uC704\uCE58\uC640
      \uC811\uADFC \uACF5\uAC04\uC744 \uD655\uC778\uD569\uB2C8\uB2E4. \uBD84\uC0AC\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC774 \uD56D\uBAA9\uC740 \uCD94\uAC00 \uC548\uC804
      \uC7A5\uBE44 \uAD50\uC721\uC785\uB2C8\uB2E4."
    Result: "\uC18C\uD654\uAE30 \uC704\uCE58\uC640 \uC678\uAD00\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.\n\uC774\uC0C1\uC774
      \uC788\uC73C\uBA74 \uBCF4\uACE0\uD574\uC57C \uD569\uB2C8\uB2E4."
    TargetId: extinguisher
    Action: 3
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: 800fe5c76a14d654b89c3ed0b3e6784c, type: 3}
    ResponseVoice: {fileID: 0}
    Observation: "\uC18C\uD654\uAE30 \uC218\uB0A9\uD568\uC758 \uC704\uCE58\n\uC55E\uC758
      \uC811\uADFC \uACF5\uAC04"
  - Chapter: "\uAC1D\uC2E4 \uC810\uAC80"
    Title: "\uAC1D\uC2E4 \uC55E\uCABD \uC88C\uC11D\xB7\uC8FC\uBCC0 \uC124\uBE44 \uC810\uAC80"
    Instruction: "\uAC1D\uC2E4 \uC55E\uCABD \uD45C\uC2DD\uC73C\uB85C \uC774\uB3D9\uD574
      \uC88C\uC11D\uC5D0\uC11C E\uB97C \uB204\uB974\uC138\uC694.\n\uC774\uC5B4\uC11C
      \uD45C\uC2DD\uC774 \uAC00\uB9AC\uD0A4\uB294 \uC88C\uC11D \u2192 \uCC3D\uAC00\xB7\uC8FC\uBCC0
      \uC124\uBE44 \u2192 \uC120\uBC18\uC744 \uD558\uB098\uC529 \uBC14\uB77C\uBCF4\uC138\uC694.
      \uC678\uAD00\uACFC \uC774\uC0C1 \uC720\uBB34\uB97C \uC0B4\uD54D\uB2C8\uB2E4."
    Result: "\uAC1D\uC2E4 \uC55E\uCABD\uC758 \uC88C\uC11D\xB7\uCC3D\uAC00\xB7\uC120\uBC18\uC744
      \uAD00\uCC30\uD588\uC2B5\uB2C8\uB2E4.\n\uC601\uC0C1\uC758 \uAC1D\uC2E4 \uC21C\uD68C\uCC98\uB7FC
      \uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD558\uBA70 \uC810\uAC80\uD569\uB2C8\uB2E4."
    TargetId: cabin-left
    Action: 5
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: cc7e54cb298335e42b16b2f2faecdca7, type: 3}
    ResponseVoice: {fileID: 0}
    Observation: "\uC88C\uC11D \u2192 \uCC3D\uAC00\xB7\uC8FC\uBCC0 \uC124\uBE44 \u2192
      \uC120\uBC18\n\uD45C\uC2DD\uB300\uB85C \uC9C1\uC811 \uAD00\uCC30"
  - Chapter: "\uAC1D\uC2E4 \uC810\uAC80"
    Title: "\uAC1D\uC2E4 \uC911\uC559 \uC88C\uC11D\xB7\uC8FC\uBCC0 \uC124\uBE44 \uC810\uAC80"
    Instruction: "\uD45C\uC2DC\uB41C \uAC1D\uC2E4 \uC911\uC559\uC73C\uB85C \uC774\uB3D9\uD574
      \uBC18\uB300\uCABD \uC88C\uC11D\uC5D0\uC11C E\uB97C \uB204\uB974\uC138\uC694.\n\uC88C\uC11D
      \u2192 \uCC3D\uAC00\xB7\uC8FC\uBCC0 \uC124\uBE44 \u2192 \uC120\uBC18\uC744
      \uCC28\uB840\uB85C \uBC14\uB77C\uBCF4\uBA70 \uCC28\uB7C9 \uC774\uC0C1\uC744
      \uD655\uC778\uD569\uB2C8\uB2E4."
    Result: "\uB450 \uAD6C\uC5ED\uC758 \uC88C\uC11D\uACFC \uC8FC\uBCC0 \uC124\uBE44\uB97C
      \uC774\uB3D9\uD558\uBA70 \uC810\uAC80\uD588\uC2B5\uB2C8\uB2E4.\n\uC601\uC0C1\uCC98\uB7FC
      \uAC1D\uC2E4\uC758 \uCF8C\uC801\uD55C \uC0C1\uD0DC\uB3C4 \uC0B4\uD54D\uB2C8\uB2E4."
    TargetId: cabin-right
    Action: 5
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: 17cfd93c8fb243943a899b9d0721e522, type: 3}
    ResponseVoice: {fileID: 0}
    Observation: "\uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\n\uBC18\uB300\uCABD
      \uC88C\uC11D\uACFC \uC8FC\uBCC0 \uC124\uBE44"
  - Chapter: "\uAC1D\uC2E4 \uC810\uAC80"
    Title: "\uB354\uC6B4 \uAC1D\uC2E4\uC758 \uB0C9\uBC29 \uC124\uC815 \uC870\uC808"
    Instruction: "\uC601\uC0C1\uC5D0\uC11C\uCC98\uB7FC \uB354\uC6B4 \uAC1D\uC2E4\uC758
      \uC628\uB3C4 \uC124\uC815\uC744 \uB0AE\uCD94\uB294 \uAD50\uC721 \uC0C1\uD669\uC785\uB2C8\uB2E4.\n\uB0C9\uB09C\uBC29
      \uC81C\uC5B4\uBC18 \uD45C\uC2DD\uC73C\uB85C \uC774\uB3D9\uD574 E\uB97C \uB204\uB974\uC138\uC694.
      \uC124\uC815 \uBCC0\uACBD \uD45C\uC2DC\uB97C \uD655\uC778\uD569\uB2C8\uB2E4."
    Result: "\uB354\uC6B4 \uAC1D\uC2E4\uC5D0 \uB9DE\uCDB0 \uC81C\uC5B4\uBC18\uC758
      \uC628\uB3C4 \uC124\uC815\uC744 \uB0AE\uCDC4\uC2B5\uB2C8\uB2E4.\n\uC2B9\uAC1D\uC774
      \uD3B8\uC548\uD558\uAC8C \uC774\uC6A9\uD558\uB3C4\uB85D \uAC1D\uC2E4 \uC0C1\uD0DC\uB97C
      \uC0B4\uD53C\uACE0 \uC870\uC808\uD558\uB294 \uC5C5\uBB34\uC785\uB2C8\uB2E4."
    TargetId: climate
    Action: 12
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: c333067c69997aa4dbbed4d03ffca29d, type: 3}
    ResponseVoice: {fileID: 0}
    Observation: "\uB354\uC6B4 \uAC1D\uC2E4\uC758 \uC124\uC815 \uC870\uC808\n\uC81C\uC5B4\uBC18\uC758
      \uC628\uB3C4 \uB0AE\uCDA4 \uD45C\uC2DC"
  - Chapter: "\uCD9C\uC785\uBB38 \uC810\uAC80"
    Title: "\uCD9C\uC785\uBB38 \uC774\uC0C1 \uD655\uC778"
    Instruction: "\uCD9C\uC785\uBB38 \uD45C\uC2DD\uC5D0\uC11C E\uB97C \uB20C\uB7EC
      \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC138\uC694.\n\uC774 \uAD50\uC721 \uC0AC\uB840\uC5D0\uC11C\uB294
      \uC9D0 \uB54C\uBB38\uC5D0 \uBB38\uC774 \uC644\uC804\uD788 \uB2EB\uD788\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uBB38 \uD2C8\uACFC \uC9D0\uC744 \uD568\uAED8
      \uD655\uC778\uD569\uB2C8\uB2E4."
    Result: "\uBB38\uC774 \uB35C \uB2EB\uD600 \uC788\uACE0 \uC9D0\uC774 \uBB38 \uC8FC\uBCC0\uC744
      \uB9C9\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uBA3C\uC800 \uCD9C\uBC1C \uBCF4\uB958\uB97C
      \uC804\uB2EC\uD569\uB2C8\uB2E4."
    TargetId: door
    Action: 6
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: 37b6c56a008b2494683a226ca95eeafc, type: 3}
    ResponseVoice: {fileID: 0}
    Observation: "\uB35C \uB2EB\uD78C \uBB38\uACFC \uC2B9\uAC1D\uC758 \uC9D0\n\uCD9C\uBC1C
      \uC804 \uC0C1\uD0DC \uD655\uC778"
  - Chapter: "\uCD9C\uC785\uBB38 \uC870\uCE58"
    Title: "\uCD9C\uBC1C \uBCF4\uB958 \uC804\uB2EC"
    Instruction: "Q\uB97C \uB204\uB978 \uCC44 \uBB34\uC804 \uBB38\uC7A5\uC744 \uC120\uD0DD\uD558\uACE0
      Q\uB97C \uB5BC\uC138\uC694.\n\uD45C\uC900\xB7\uC2E4\uC804\uC740 \u2018\uC694\uCCAD
      \xB7 \uC124\uBE44\u2019\uB97C \uC88C\uD074\uB9AD\uC73C\uB85C \uC5F4\uACE0 \u2018\uC5F4\uCC28
      \uCD9C\uBC1C \uBCF4\uB958\u2019\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4. \uACAC\uD559\uC740
      \uBB38\uC7A5\uC744 \uBC14\uB85C \uC120\uD0DD\uD569\uB2C8\uB2E4."
    Result: "\uCD9C\uBC1C \uBCF4\uB958\uC640 \uC0C1\uB300\uC758 \uC218\uC2E0 \uD655\uC778\uC744
      \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4.\n\uC9D0 \uC815\uB9AC\uB97C \uC704\uD574 \uBB38\uC744
      \uAC1C\uBC29\uD569\uB2C8\uB2E4."
    TargetId: 
    Action: 7
    HandheldRadio: 1
    GuidanceVoice: {fileID: 8300000, guid: 2d9e713304d86ad4b890957b9b2c1afd, type: 3}
    ResponseVoice: {fileID: 8300000, guid: 0a7d87a247b91764fa84cdcd45eaf23f, type: 3}
    Observation: "\uCD9C\uBC1C \uBCF4\uB958\uC640 \uC218\uC2E0 \uD655\uC778\n\uD734\uB300
      \uBB34\uC804\uAE30 \uC0AC\uC6A9"
  - Chapter: "\uCD9C\uC785\uBB38 \uC870\uCE58"
    Title: "\uBB38 \uAC1C\uBC29"
    Instruction: "\uCD9C\uC785\uBB38 \uCDE8\uAE09 \uC7A5\uCE58\uC5D0\uC11C E\uB97C
      \uB204\uB974\uC138\uC694.\n\uCD9C\uBC1C \uBCF4\uB958 \uC0C1\uD0DC\uC5D0\uC11C
      \uBB38\uC744 \uAC1C\uBC29\uD558\uACE0 \uC2E4\uC81C \uC6C0\uC9C1\uC784\uC744
      \uD655\uC778\uD569\uB2C8\uB2E4."
    Result: "\uBB38\uC744 \uAC1C\uBC29\uD588\uC2B5\uB2C8\uB2E4.\n\uC2B9\uAC1D\uC5D0\uAC8C
      \uC9D0 \uC815\uB9AC\uB97C \uC694\uCCAD\uD569\uB2C8\uB2E4."
    TargetId: control
    Action: 8
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: 4e3719635d7c9a841a852f88a0d267f7, type: 3}
    ResponseVoice: {fileID: 0}
    Observation: "\uC2E4\uC81C \uBB38\uC774 \uC5F4\uB9AC\uB294 \uBAA8\uC2B5\n\uC9D0
      \uC815\uB9AC \uACF5\uAC04 \uD655\uBCF4"
  - Chapter: "\uCD9C\uC785\uBB38 \uC870\uCE58"
    Title: "\uC2B9\uAC1D\uC5D0\uAC8C \uC9D0 \uC815\uB9AC \uC694\uCCAD"
    Instruction: "\uC9D0 \uD45C\uC2DD\uC5D0\uC11C E\uB97C \uB20C\uB7EC \uC815\uB9AC\uB97C
      \uC694\uCCAD\uD558\uC138\uC694.\n\uC2B9\uAC1D\uC758 \uC751\uB2F5\uACFC \uC9D0\uC774
      \uBB38 \uC8FC\uBCC0\uC5D0\uC11C \uC774\uB3D9\uD558\uB294 \uBAA8\uC2B5\uC744
      \uD655\uC778\uD569\uB2C8\uB2E4."
    Result: "\uC2B9\uAC1D\uC774 \uC9D0\uC744 \uBB38 \uC8FC\uBCC0\uC5D0\uC11C \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4.\n\uC7A5\uC560\uBB3C\uC774
      \uC0AC\uB77C\uC9C4 \uB4A4 \uBB38\uC744 \uB2EB\uC2B5\uB2C8\uB2E4."
    TargetId: luggage
    Action: 9
    HandheldRadio: 0
    GuidanceVoice: {fileID: 8300000, guid: a5403aab9d6e856408782e279c1e21d4, type: 3}
    ResponseVoice: {fileID: 8300000, guid: 9ca002261116ec14abc5ea95c5a0b4e8, type: 3}
    Observation: "\uC2B9\uAC1D \uC751\uB2F5\uACFC \uC9D0 \uC774\uB3D9\n\uBB38 \uC8FC\uBCC0\uC758
      \uC7A5\uC560\uBB3C \uC815\uB9AC"
  - Chapter: "\uCD9C\uC785\uBB38 \uC870\uCE58"
    Title: "\uBB38 \uB2EB\uD798 \uD655\uC778"
    Instruction: "\uCD9C\uC785\uBB38 \uCDE8\uAE09 \uC7A5\uCE58\uC5D0\uC11C E\uB97C
