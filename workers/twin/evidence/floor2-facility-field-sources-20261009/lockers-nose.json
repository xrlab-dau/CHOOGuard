      "text": "",
      "images": [
        {
          "src": "https://postfiles.pstatic.net/MjAyNjA1MTlfMTM1/MDAxNzc5MTkxODU3NzQ0.C1A2_PH5b8e_EBRgsq8KJmR-7aaB5N3opEVBU-_yrjUg.z7mArPXnEKPJrmw9CZjeOwipdWVnPYYX3bnwXc8ykRcg.PNG/%EC%A7%81%EA%B4%80%EA%B0%80%EC%9D%B4%EB%93%9C_%EB%B3%B5%EA%B5%AC%EB%90%A8-04.png?type=w966",
