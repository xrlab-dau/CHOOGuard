  "scripts": [
    "\n\n\tvar page=1;\n\tfunction showDetail(obj){\t\n\t\t$(\".ad_area_list\").find(\"a\").removeClass(\"current\");\n\t\t$(\"#\"+obj).find(\"a\").addClass(\"current\");\n\t\tad_area_name = $(\"#\"+obj).find(\".ad_area_name\").text();\n\t\t$(\".ad_detail\").find(\".ad_area_tit\").text(ad_area_name);\n\t\t\n\t\t$(\".ad_info_table\").children(\"dl:eq(0)\").children(\"dd:eq(0)\").text(ad_area_name);\t\t\n\t\t$(\".ad_info_table\").children(\"dl:eq(2)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-instlLc'));\n\t\t$(\".ad_info_table\").children(\"dl:eq(3)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-mdiKind'));\n\t\t$(\".ad_info_table\").children(\"dl:eq(4)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-size'));\n\t\t$(\".ad_info_table\").children(\"dl:eq(5)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-salePc')+\"(원, VAT별도)\");\n\t\t\n\t\t\n\t\t\n\t\t$(\".ad_info_table\").children(\"dl:eq(6)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-salePosblYmd'));\n\t\t\n\t\t\n\t\t\n\t\t$('form[name=\"inquiryForm\"]').find('input[name=custCd]').val($(\"#\"+obj).attr('data-custCd'));\n\t\t$('form[name=\"inquiryForm\"]').find('input[name=stdMdiNo]').val($(\"#\"+obj).attr('data-stdMdiNo'));\n\t\t$('form[name=\"inquiryForm\"]').children(\".form_box\").children(\"dl:eq(0)\").children(\"dd:eq(0)\").text(ad_area_name);\t\t\n\t\t$('form[name=\"inquiryForm\"]').children(\".form_box\").children(\"dl:eq(2)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-instlLc'));\n\t\t$('form[name=\"inquiryForm\"]').children(\".form_box\").children(\"dl:eq(3)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-mdiKind'));\n\t\t$('form[name=\"inquiryForm\"]').children(\".form_box\").children(\"dl:eq(4)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-size'));\n\t\t$('form[name=\"inquiryForm\"]').children(\".form_box\").children(\"dl:eq(5)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-salePc')+\"(원, VAT별도)\");\n\t\t\n\t\t\n\t\t\n\t\t$('form[name=\"inquiryForm\"]').children(\".form_box\").children(\"dl:eq(6)\").children(\"dd:eq(0)\").text($(\"#\"+obj).attr('data-salePosblYmd'));\n\t\t\n\t\t\n\t\tvar atchmnflId = $(\"#\"+obj).attr('data-atchmnfl2Id');\n\t\t\n\t\t\n\t\t$.ajax({\n\t\t\ttype:\"GET\",\n\t\t\turl:\"/krs/detailMediaImgListAjax.do\",\n\t\t\tdata:{\n\t\t\t\t\n\t\t\t\t\"atchFileId\" :atchmnflId\n\t\t\t},\n\t\t\tdataType:'json',\n\t\t\tasync :false,\n\t\t\t//timeout:(1000*30),\n\t\t\tsuccess:function(returnData, status){\t\t\t\t\n\t\t\t\tif(status == \"success\") {\n\t\t\t\t\tvar topImg = \"\";\n\t\t\t\t\tvar thumbImg = \"\";\n\t\t\t\t\t$(\".slide_top\").find(\".swiper-wrapper\").empty();\n\t\t\t\t\t$(\".slide_thumb\").find(\".swiper-wrapper\").empty();\n\t\t\t\t\t//swiper.removeAllSlides();\n\t\t\t\t\t$.each(returnData.detailMediaImgList,function(index,item){ //이건 foreach문 으로 결과출력 위와 동일하게 나타난다.\n\t\t\t\t\t\ttopImg +='<div class=\"swiper-slide\"><img src=\"/krs/getImage.do?atchFileId='+item.atchFileId+'&fileSn='+item.fileSn+'\" alt=\"사진설명 넣어주세요'+item.fileSn+'\"></div>';\n\t\t\t\t\t\tthumbImg +='<div class=\"swiper-slide\"><div class=\"thumb\" style=\"background:url(/krs/getImage.do?atchFileId='+item.atchFileId+'&fileSn='+item.fileSn+');\"></div><p>사진'+item.fileSn+'</p></div>';\n\t\t\t\t\t\t//topImg +='<div class=\"swiper-slide\"><img src=\"images/advertise/seoul1_'+(index+1)+'.jpg\" alt=\"사진설명 넣어주세요'+(index+1)+'\" ></div>';\t\t\t\t\t\n\t\t\t\t\t\t//thumbImg +='<div class=\"swiper-slide swiper-slide-visible\" style=\"width: 108px; margin-right: 5px;\"><img src=\"images/advertise/seoul1_'+(index+1)+'.jpg\" alt=\"\" ><p>사진'+(index+1)+'</p></div>';\n\t\t\t\t\t\t\n\t\t\t\t\t})\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t//swiper.appendSlide(topImg);\n\t\t\t\t\t\n\t\t\t\t\t $(\".slide_top\").find(\".swiper-wrapper\").append(topImg);\n\t\t\t\t\t\n\t\t\t\t\t \n\t\t\t\t\t$(\".slide_thumb\").find(\".swiper-wrapper\").append(thumbImg);\t\t\t\t\t\n\t\t\t\t      \n\t\t\t\t\t//광고이미지 슬라이드\n\t\t\t\t\tvar adImgThumbs = new