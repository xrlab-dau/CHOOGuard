        "path": "asset-library/research-public/2026-10-09/floor2-guide-passages/source03-lifeistravel-002.jpg",
        "sha256": "48af8220f83c6a8774cfd49cbdc74893f4c3206f1ce544d24ddffc90fcf0fb11",
        "bytes": 234994,
        "content_type": "image/png",
