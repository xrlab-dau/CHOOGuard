'); \n\t\t}\n\t} else if (st <= 0) {\n\t\tif ($('.header_wrap').hasClass('scrolled')) {\n\t\t\t$('.header_wrap').removeClass('scrolled'); \n\t\t}\n\t} \n\n\tlastScrollTop = st;\n\n\t// 일정 시간 후 실행 완료 상태로 변경 (중복실행 방지)\n\tsetTimeout(function() {\n\t\tingScroll = false;\n\t}, 200);\n\n\tsetTimeout(function() {\n\t\t$('.header_wrap').removeClass('load');\n\t}, 700);\n}\n\nfunction m_menu_open() {\n\tif ($('.mnb').is(':hidden')) $('.mnb').slideDown('fast');\n\telse $('.mnb').slideUp('fast');\n}\n\nfunction mnb_search() {\n\tvar z = [];\n\tz.title = '전체검색';\n\tz.url = '../inc/inc.search.php';\n\tz.ww = '940px';\n\tz.hh = '300px';\n\tsecondViewOpen(z);\n}\n//]]>\n"},{"src":"","text":"\n<!--\n// onsu : sear\nfunction onsuSear() {\n\tajax(\"\", \"\", \"\", \"\", $(\"#SC_word\").val(), \"\");\n\treturn false;\n}\n\n// oncl : sear\nfunction onclSear() {\n\t$(\"#frmSear\").submit();\n}\n\nfunction onch_SC() {\n\tajax($(\"#SC_LP\").val(), $(\"#SC_YEAR\").val(), $(\"#SC_SUPPLY\").val(), $(\"#SC_LOCAL\").val(), \"\", \"\");\n}\n\nfunction oncl_SC(val1, val2, val3, val4) {\n\tajax(val1, val2, val3, val4, \"\", \"\");\n\t//window.location.href = \"../board/perform.list.php?BBS_GUBUN=1&SC_LP=\" + val1 + \"&SC_YEAR=\" + val2 + \"&SC_SUPPLY=\" + val3 + \"&SC_LOCAL=\" + val4;\n}\n\nfunction ajax(SC_LP, SC_YEAR, SC_SUPPLY, SC_LOCAL, SC_word, page) {\n\tif(page == \"\") {\n\t\tif(SC_LP != \"\" || SC_YEAR != \"\" || SC_SUPPLY != \"\" || SC_LOCAL != \"\") {\n\t\t\tSC_word = \"\";\n\n\t\t\tif (SC_LP != \"\") $('#SC_LP').parent().addClass('on');\n\t\t\telse $('#SC_LP').parent().removeClass('on');\n\t\t\tif (SC_YEAR != \"\") $('#SC_YEAR').parent().addClass('on');\n\t\t\telse $('#SC_YEAR').parent().removeClass('on');\n\t\t\tif (SC_SUPPLY != \"\") $('#SC_SUPPLY').parent().addClass('on');\n\t\t\telse $('#SC_SUPPLY').parent().removeClass('on');\n\t\t\tif (SC_LOCAL != \"\") $('#SC_LOCAL').parent().addClass('on');\n\t\t\telse $('#SC_LOCAL').parent().removeClass('on');\n\t\t} else if(SC_word != \"\") {\n\t\t\tSC_LP = \"\";\n\t\t\tSC_YEAR = \"\";\n\t\t\tSC_SUPPLY = \"\";\n\t\t\tSC_LOCAL = \"\";\n\n\t\t\t$('.slt_wrap').removeClass('on');\n\t\t} else {\n\t\t\tSC_LP = \"\";\n\t\t\tSC_YEAR = \"\";\n\t\t\tSC_SUPPLY = \"\";\n\t\t\tSC_LOCAL = \"\";\n\t\t\tSC_word = \"\";\n\n\t\t\t$('.slt_wrap').removeClass('on');\n\t\t}\n\t}\n\n\t$.ajax({ url: '../json/perform.list.php', type: 'POST', dataType: 'html',\n\t\tdata: {\n\t\t\tBBS_GUBUN: \"1\",\n\t\t\tSC_LP: ((SC_LP == \"ALL\") ? \"\" : SC_LP) ,\n\t\t\tSC_YEAR: ((SC_YEAR == \"ALL\") ? \"\" : SC_YEAR),\n\t\t\tSC_SUPPLY: ((SC_SUPPLY == \"ALL\") ? \"\" : SC_SUPPLY),\n\t\t\tSC_LOCAL: ((SC_LOCAL == \"ALL\") ? \"\" : SC_LOCAL),\n\t\t\tSC_word : SC_word,\n\t\t\tpage: page\n\t\t}\n\t})\n\t.done(function(html) {\n\t\t$arr.off();\n\n\n\t\tif(page == \"\") {\n\t\t\tif(SC_LP != \"\" || SC_YEAR != \"\" || SC_SUPPLY != \"\" || SC_LOCAL != \"\") {\n\t\t\t\t$(\"#SC_word\").val(\"\");\n\t\t\t} else if(SC_word != \"\") {\n\t\t\t\t$(\"#SC_LP\").val(\"\");\n\t\t\t\t$(\"#SC_YEAR\").val(\"\");\n\t\t\t\t$(\"#SC_SUPPLY\").val(\"\");\n\t\t\t\t$(\"#SC_LOCAL\").val(\"\");\n\t\t\t} else {\n\t\t\t\t$(\"#SC_LP\").val(\"\");\n\t\t\t\t$(\"#SC_YEAR\").val(\"\");\n\t\t\t\t$(\"#SC_SUPPLY\").val(\"\");\n\t\t\t\t$(\"#SC_LOCAL\").val(\"\");\n\t\t\t\t$(\"#SC_word\").val(\"\");\n\t\t\t}\n\t\t}\n\n\t\t$(\"#div_ajax\").html(html);\n\n\n\t\t$('#div_ajax img.lazy').each(function() {\n\t\t\t$(this).css ( { display:\"block\" , opacity:0 } ).delay ( Math.random()*700 ).animate ( { opacity:1 } , 600 );\n\t\t});\n\n\n\t\t$arr = $('.project_lst_wrap [class*=\"arr_\"]');\n\n\t\t$arr.mouseover(function() {\n\t\t\t$(this).css({opacity:1});\n\t\t}).mouseleave(function() {\n\t\t\t$(this).css({opacity:0.5});\n\t\t});\n\n\t\tif ($arr.length > 0) project_arr();\n\t});\n}\n\nfunction projRead(o) {\n\tif (o.c == '' || o.t == '') return;\n\tvar z = [];\n\tz.title = o.t;\n\tz.url = '../board/perform.read.php?BBS_GUBUN=1&BBS_IDX='+o.c;\n\tz.ww = '1100px';\n\tz.hh = '90%';\n\tz.onclose = 'projClose()';\n\tsecondViewOpen(z);\n\n\t$('.project_lst_wrap [class*=\"arr\"]').css({opacity:0});\n}\n\nfunction projClose() {\n\t$('.project_lst_wrap [class*=\"arr\"]').css({opacity:1});\n}\n\nfunction proj_resize() {\n\tvar t = $('.modal').attr('style');\n\t$('.modal').attr('style', '');\n\t$('.modal').attr('style', t)\n}\n//-->\n"},{"src":"","text":"\n//<![CDATA[\nvar lst = 0, $arr;\n$(document).ready(function() {\n\t$arr = $('.project_lst_wrap [class*=\"arr_\"]');\n\n\t$arr.mouseover(function() {\n\t\t$(this).css({opacity:1});\n\t}).mouseleave(function() {\n\t\t$(this).css({opacity:0.5});\n\t});\n\n\t$(document).on('mouseover', '.project_lst2 li a', function() {\n\t\t$('.img', this).css({width:'105%', 'max-width':'105%', top:'-2.5%', left:'-2.5%'});\n\t}).on('mouseleave', '.project_lst2 li a', function() {\n\t\t$('.img', this).css({width:'100%', 'max-width':'100%', top:'0', left:'0'});\n\t});\n\n\t$('#div_ajax img.lazy').each(function() {\n\t\t$(this).css ( { display:\"block\" , opacity:0 } ).delay ( Math.random()*700 ).animate ( { opacity:1 } , 600 );\n\t});\n\n\n\t$('.tab2 li a').click(function() {\n\t\tvar id = $(this).attr('data-id');\n\n\t\t$('.tab2 li a').removeClass('aon');\n\t\t$('.tab2 li a[data-id=\"'+id+'\"]').addClass('aon');\n\n\t\tif (id == 'filter' || id == 'search') {\n\t\t\tif (id == 'filter') $('#search_div').hide();\n\t\t\telse $('#filter_div').hide();\n\n\t\t\tif ($('.tab2_div').is(':hidden')) $('.tab2_div').slideDown('fast');\n\n\t\t\t$('#'+id+'_div').fadeIn('fast');\n\t\t} else {\n\t\t\t$('.tab2_div').slideUp('fast');\n\t\t\tajax(\"\", \"\", \"\", \"\", \"\", \"\");\n\t\t}\n\t});\n});\n\n$(window).load(function() {\n\tif ($arr.length > 0) project_arr();\n});\n\n$(window).scroll(function() {\n\tif ($arr.length > 0) project_arr();\n});\n\nfunction project_arr() {\n\tvar wt = $(window).scrollTop(), wh = $(window).height()\n\t\t, arr_t = $arr.offset().top\n\t\t, st = wt + (wh / 2) - ($arr.height() / 2)\n\t\t, pr_t = $('.project_lst_wrap').offset().top\n\t\t, pr_h = $('.project_lst_wrap').height();\n\n\t// 처음에 스크롤 위치 체크\n\tif (st > pr_t + pr_h - 300) {\n\t\t$('.project_lst_wrap').find('[data-id=\"arr\"]').css('top', pr_h - 300);\n\t}\n\n\t// 스크롤 내릴 때\n\tif (wt > lst) {\n\t\t// 현재 화면 중앙의 스크롤 위치가 화살표의 위치를 넘는 경우\n\t\tif (st > arr_t && st < pr_t + pr_h - 300) {\n\t\t\t$('.project_lst_wrap').find('[data-id=\"arr\"]').css('top', st - pr_t);\n\t\t}\n\t}\n\t// 스크롤 올릴 때\n\telse {\n\t\t// 현재 화면 중앙의 스크롤 위치가 화살표의 위치를 넘지 않는 경우\n\t\tif (st < arr_t && st > pr_t + 300 - ($arr.height() / 2)) {\n\t\t\t$('.project_lst_wrap').find('[data-id=\"arr\"]').css('top', st - pr_t);\n\t\t}\n\t}\n\n\tlst = wt;\n}\n//]]>\n"},{"src":"","text":"\n//<![CDATA[\nfunction secondViewOpen(o) {\n\t$.centermodal.open(o);\n}\nfunction secondViewClose() {\n\t$.centermodal.close();\n}\n//]]>\n"},{"src":"","text":"\n\t//<![CDATA[\n\tvar st, $tab_outer, $tab, $tab2; // 탭메뉴 관련\n\t$(document).ready(function() {\n\t\tst = $(window).scrollTop();\n\n\t\t$tab_outer = $('#menu-snb-outer');\n\t\t$tab = $('#menu-snb-tab');\n\t\t$tab2 = $('.tab2'); // 탭메뉴 관련\n\n\t\t$tab.addClass('after');\n\n\t\tvar myt;\n\t\tvar _resize = function() {\n\t\t\tclearTimeout(myt);\n\t\t\tmyt = setTimeout(function() {\n\t\t\t\t// 탭메뉴\n\t\t\t\t//if ($tab.length > 0) tabScroll();\n\t\t\t\tif ($tab.length > 0) {\n\t\t\t\t\t$tab_outer.css({height:$tab.height(), 'margin-top':0});\n\t\t\t\t}\n\t\t\t\tif ($tab2.length > 0) tabScroll2();\n\n\t\t\t\t$('body').css('padding-top', $('.header_wrap').height());\t\t\t\t\n\t\t\t}, 300);\n\t\t}\n\t\t//_resize();\n\n\t\t$(window).on({\n\t\t\tresize: function() {\n\t\t\t\t//_resize();\n\t\t\t}\n\t\t\t, scroll: function() {\n\t\t\t\tst = $(this).scrollTop();\n\n\t\t\t\t// 탭메뉴\n\t\t\t\t//if ($tab.length > 0) tabScroll();\n\t\t\t\tif ($tab2.length > 0) tabScroll2();\n\t\t\t}\n\t\t});\n\t});\n\n\t// 스크롤시 탭 컨트롤\n\tfunction tabScroll() {\n\t\tvar hh = $('.header_wrap').outerHeight();\n\t\tvar tab_st = Math.floor($('.tab_wrap').offset().top);\n\n\t\tif (st >= tab_st - hh) {\n\t\t\tif (!$tab.hasClass('scrolled')) {\n\t\t\t\t$tab.addClass('scrolled');\n\t\t\t\t// 탭메뉴의 높이 넣음으로 내용영역 변화 방지\n\t\t\t\t$('.tab_wrap').height($tab.height());\n\t\t\t}\n\t\t} else {\n\t\t\tif ($tab.hasClass('scrolled')) {\n\t\t\t\t$tab.removeClass('scrolled');\n\t\t\t\t$('.tab_wrap').height('auto');\n\t\t\t}\n\t\t}\n\t}\n\n\tfunction tabScroll2() {\n\t\tvar hh = $('.header_wrap').outerHeight();\n\t\tvar tab_st = Math.floor($('.tab2_wrap').offset().top);\n\n\t\tif ($tab.length > 0) hh = hh + $tab.height();\n\n\t\tif (st >= tab_st - hh) {\n\t\t\tif (!$tab2.hasClass('scrolled') || !$tab2.hasClass('scrolled2')) {\n\t\t\t\t// 탭메뉴의 높이 넣음으로 내용영역 변화 방지\n\t\t\t\tif (!$('.tab2_div').is(':hidden')) $('.tab2_wrap').height($tab2.height() + $('.tab2_div').outerHeight());\n\t\t\t\telse $('.tab2_wrap').height($tab2.height());\n\n\t\t\t\tif ($tab.length > 0) $tab2.addClass('scrolled2');\n\t\t\t\telse $tab2.addClass('scrolled');\n\t\t\t}\n\t\t} else {\n\t\t\tif ($tab2.hasClass('scrolled') || $tab2.hasClass('scrolled2')) {\n\t\t\t\t$('.tab2_wrap').height('auto');\n\n\t\t\t\tif ($tab.length > 0) $tab2.removeClass('scrolled2');\n\t\t\t\telse $tab2.removeClass('scrolled');\n\t\t\t}\n\t\t}\n\t}\n\t//]]>\n\t"}]}
