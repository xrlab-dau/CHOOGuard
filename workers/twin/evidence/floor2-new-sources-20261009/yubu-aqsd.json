          "full": "https://mblogthumb-phinf.pstatic.net/MjAyNjAxMTFfMjI4/MDAxNzY4MTQyODQ5MTkz.slGPljmuooRTF5SVYbxxL0J-sW1HhzRLsyqCwoa1frkg.s93-7Yj7AnHACU6NcSbAGbYlM7jOueULv82MFuBQCrYg.JPEG/2025_12_29_20_23_IMG_6180.JPG?type=w80_blur"
