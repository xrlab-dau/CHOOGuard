&HEAD CHID='hall', TITLE='CHOOGuard 1800 s reference hall, not Busan calibration' /
&MESH IJK=60,40,8, XB=0,30,0,20,0,4 /
&TIME T_END=1800.0 /
&MISC TMPA=20.0 /
&REAC ID='PROPANE_REFERENCE', FUEL='PROPANE', SOOT_YIELD=0.10, CO_YIELD=0.02 /
&SURF ID='BURNER', HRRPUA=250., TAU_Q=10.0 /
&OBST XB=14,16,4,6,0,0.5, SURF_IDS='BURNER','INERT','INERT' /
&OBST XB=24,25,0,9,0,4 /
&OBST XB=24,25,11,20,0,4 /
&VENT XB=30,30,9,11,0,3, SURF_ID='OPEN' /
&SLCF PBZ=1.5, QUANTITY='EXTINCTION COEFFICIENT' /
&SLCF PBZ=1.5, QUANTITY='TEMPERATURE' /
&SLCF PBZ=1.5, QUANTITY='DENSITY', SPEC_ID='SOOT' /
&SLCF PBZ=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&SLCF PBZ=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON DIOXIDE' /
&SLCF PBZ=1.5, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DEVC ID='TEMPERATURE_C', XYZ=22,10,1.5, QUANTITY='TEMPERATURE' /
&DEVC ID='EXTINCTION_PER_M', XYZ=22,10,1.5, QUANTITY='EXTINCTION COEFFICIENT' /
&DUMP DT_SLCF=1.0, DT_DEVC=1.0, DT_HRR=1.0 /
&TAIL /
