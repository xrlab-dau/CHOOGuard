  "rules": [
    {
      "profile": "furniture-envelope",
      "ancestor": true,
      "pattern": "^MAIN1F_NEW_SF_A[0-9]{2}(?:A[0-9]{2})?_[0-9]+_(?:chair|table|bar_stool|banquette|wall_shelf|display_shelf|display_island|counter_cashier|counter|pickup_counter|pickup|service_counter|cup_dish|menu_stand|order_counter|counter_order|locker_bank|cabinet)$",
      "group": "source"
    },
    {
      "profile": "electrical-device",
      "ancestor": true,
      "pattern": "^MAIN1F_NEW_SF_A[0-9]{2}(?:A[0-9]{2})?_[0-9]+_(?:pos_terminal|refrigerated_showcase|refrigerated_wall_case)$",
      "group": "source"
    },
    {
      "profile": "glazing-envelope",
      "pattern": "^MAIN1F_RETAIL_NEW_(?:[RD][0-9]+_P[0-9]+_S[0-9]+|B[0-9]+_PU[0-9]+_S[0-9]+)_(?:M[0-9]+|B[0-9]+_(?:SILL|HEAD))$",
      "group": "regex",
      "assemblyPattern": "^(?<assembly>MAIN1F_RETAIL_NEW_(?:[RD][0-9]+_P[0-9]+_S[0-9]+|B[0-9]+_PU[0-9]+_S[0-9]+))_.*$"
    },
    {
      "profile": "mineral-structure",
      "pattern": "^MAIN1F_AP958_USER093_COLUMN_[0-9]{3}(?:_|$)",
      "group": "regex",
      "assemblyPattern": "^(?<assembly>MAIN1F_AP958_USER093_COLUMN_[0-9]{3})(?:_|$)"
    },
    {
      "profile": "unknown-barrier",
      "pattern": "^MAIN1F_A[0-9]{2}(?:_A[0-9]{2})?.*_(?:MULLION|JAMB|LOUVER)(?:_|$)",
      "group": "shop"
    },
    {
      "profile": "wood-liner",
      "pattern": "^MAIN1F_A18C1_WOOD_DISPLAY_SHELF_[0-9]P[0-9]+$",
      "group": "shop"
    },
    {
      "profile": "electrical-device",
      "ancestor": true,
      "pattern": "^MAIN1F_EV_(?:WEST|EAST|FRONT_SE_[NS]|FRONT_SW_[NS])$",
      "group": "source"
    },
    {
      "profile": "electrical-device",
      "ancestor": true,
      "pattern": "^MAIN1F_(?:INDOOR_EAST_ESC_(?:UP|DN)_8804_[0-9]+_B5|CENTRAL_ESC_K_[A-Z0-9_]+_B8)$",
      "group": "source"
    },
    {
      "profile": "water-fixture",
      "ancestor": true,
      "pattern": "^MAIN1F_NEW_WC_(?:EM|EW|WM|WW)_(?:.*_)?(?:TOILET(?:_[0-9]+)?|URINAL_[0-9]+|COUNTER_[0-9]+BASIN)$",
      "group": "source"
    },
    {
      "profile": "electrical-device",
      "pattern": "^MAIN1F_.*_(?:LEFT|RIGHT)_LAMP_(?:BODY|SHADE|SOCKET|STEM|NECK|BASE)$",
      "group": "regex",
      "assemblyPattern": "^(?<assembly>.+_(?:LEFT|RIGHT)_LAMP)_.*$"
    },
    {
      "profile": "electrical-device",
      "pattern": "^MAIN1F_.*_DOWNLIGHT_[0-9]+_(?:TRIM|LENS|BODY)$",
      "group": "regex",
      "assemblyPattern": "^(?<assembly>.+_DOWNLIGHT_[0-9]+)_.*$"
    },
    {
      "profile": "electrical-device",
      "pattern": "^MAIN1F_.*_MONITOR_(?:BODY|SCREEN)$",
      "group": "regex",
      "assemblyPattern": "^(?<assembly>.+_MONITOR)_.*$"
    },
    {
      "profile": "electrical-device",
      "pattern": "^MAIN1F_.*_CeilingLight_Engineering$",
      "group": "source"
    },
    {
      "profile": "door-envelope",
      "pattern": "^(?:BP1F_OFFICIAL_DERIVED_DOOR_.*_(?:leaf|frame)_[0-9]+|MAIN1F_.*_(?:DOOR_(?:GLASS|LEAF|FRAME|PANEL)_[0-9]+|STALLDOOR_[0-9]+))$",
      "group": "door-family"
    },
    {
      "profile": "wood-liner",
      "pattern": "^MAIN1F_.*_WOOD_DISPLAY_LINER(?:_[0-9]+)?$",
      "group": "shop"
    },
    {
      "profile": "mineral-structure",
      "pattern": "^MAIN1F_AP958_(?:NEW_STRUCT_)?COLUMN_[0-9]{3}(?:_|$)",
      "group": "regex",
      "assemblyPattern": "^(?<assembly>MAIN1F_AP958_(?:NEW_STRUCT_)?COLUMN_[0-9]{3})(?:_|$)"
    },
    {
      "profile": "mineral-structure",
      "pattern": "^MAIN1F_.*(?:_CEILING|_SOFFIT|_FASCIA|_BOXED_EDGE)(?:_|$)",
      "group": "shop"
    },
    {
      "profile": "unknown-barrier",
      "pattern": "^(?:BP1F_OFFICIAL_TILE024_.*(?:WALL|B3WALL|CORENORTH)|MAIN1F_(?!NEW_SF_).*_(?:WALL|PARTITION|WALLPANEL)(?:_|$))",
      "group": "shop"
    },
    {
      "profile": "glazing-envelope",
      "pattern": "^MAIN1F_.*_(?:GLASS|GLAZING|SIDELIGHT)(?:_|$)",
      "group": "shop"
    }
  ],
  "publicSpacePath": "FPSWorld/Architecture/1F",
  "unsupported": [
    "as-built material composition and failure rates",
    "fire/electrical/utility properties of unclassified geometry",
    "hinge/pivot/axis/travel and operability of inferred station doors",
    "actual circuit/pipe routes and protection ratings",
    "floor/room/exit accessibility and other-floor navigation",
    "physical contact, visibility and hazard propagation through partitions",
    "furniture moveability, occupied seating contact and measured furniture composition",
    "classification/operability of mixed official source meshes and unlabeled moving treads",
    "current original objects outside the immutable snapshot epoch"
  ]
