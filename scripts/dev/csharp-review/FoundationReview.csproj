<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="[3.14.0]" />
    <PackageReference Include="NUnitLite" Version="[3.14.0]" />
    <Compile Include="*.cs" />
    <Compile Include="$(CaptureSourceFile)" Condition="'$(CaptureSourceFile)' != ''" Link="ReconstructionCaptureWriter.cs" />
    <Compile Include="../../../Packages/com.xrlab.chooguard.foundation/Runtime/*.cs" Link="Foundation/Runtime/%(Filename)%(Extension)" />
    <Compile Include="../../../Packages/com.xrlab.chooguard.foundation/Tests/Editor/TrainingSessionTests.cs" Link="Foundation/Tests/TrainingSessionTests.cs" />
  </ItemGroup>
</Project>
