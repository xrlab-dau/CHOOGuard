{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xrlab-dau/CHOOGuard/context-graph.schema.json",
  "title": "CHOOGuard portable project context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "classification", "description", "nodes", "edges", "refreshLog"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "project": {"type": "string", "const": "CHOOGuard"},
    "classification": {"type": "string", "const": "PUBLIC_PROJECT_CONTEXT"},
    "description": {"type": "string", "minLength": 1, "maxLength": 600},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/edge"}},
    "refreshLog": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/refresh"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 80},
    "repoSource": {
      "type": "object", "additionalProperties": false,
      "required": ["repoPath", "sha256", "label"],
      "properties": {
        "repoPath": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "label": {"$ref": "#/$defs/text"}, "anchor": {"$ref": "#/$defs/text"}
      }
    },
    "urlSource": {
      "type": "object", "additionalProperties": false, "required": ["url", "label"],
      "properties": {"url": {"type": "string", "pattern": "^https://[^\\s]+$"}, "label": {"$ref": "#/$defs/text"}}
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "status", "authority", "topics", "observedAt", "freshnessPolicy", "sources", "limits"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"},
        "kind": {"type": "string", "enum": ["decision", "policy", "component", "contract", "workflow", "evidence", "unknown", "external_snapshot"]},
        "status": {"type": "string", "enum": ["active", "superseded", "implemented", "historical", "unknown", "snapshot", "proposed"]},
        "authority": {"type": "string", "enum": ["user_accepted", "canonical_document", "tracked_source", "execution_receipt", "external_snapshot", "unverified"]},
        "decisionKey": {"$ref": "#/$defs/id"},
        "topics": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["art", "runtime", "handoff"]}},
        "observedAt": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "freshnessPolicy": {"type": "string", "enum": ["content", "historical_evidence", "external_snapshot"]},
        "sources": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"oneOf": [{"$ref": "#/$defs/repoSource"}, {"$ref": "#/$defs/urlSource"}]}},
        "limits": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/text"}},
        "coverage": {"type": "object", "additionalProperties": false, "required": ["receipt", "field"], "properties": {"receipt": {"$ref": "#/$defs/text"}, "field": {"type": "string", "const": "sourceSha256"}}},
        "machineNotes": {"type": "object", "additionalProperties": false, "properties": {"local": {"$ref": "#/$defs/text"}, "school-pc": {"$ref": "#/$defs/text"}}}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["from", "relation", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"},
        "relation": {"type": "string", "enum": ["governed_by", "implements", "depends_on", "verified_by", "supersedes", "tracked_by", "limits_claims"]}
      }
    },
    "refresh": {
      "type": "object", "additionalProperties": false, "required": ["date", "nodes", "reason"],
      "properties": {"date": {"type": "string", "format": "date"}, "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "reason": {"type": "string", "minLength": 8, "maxLength": 1000}}
    }
  }
}
