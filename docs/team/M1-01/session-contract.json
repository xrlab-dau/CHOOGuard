        "values": [
          "prepare",
          "candidate",
          "accept"
        ]
      },
      {
        "field": "baseRef",
        "type": "sha40",
        "rule": "full 40-hex commit the session starts from"
      },
      {
        "field": "writeScope",
        "type": "array<repoPath>",
        "rule": "non-empty exact repository-relative paths from the work order phaseWriteScopes; no absolute, drive or parent-escaping path; a trailing slash or /** marks a directory scope"
      },
      {
        "field": "role",
        "type": "enum",
        "valuesFrom": "docs/team/M0-03/execution-profile.json#/roles[*]/roleId"
      },
      {
        "field": "tools",
        "type": "array<allowlistRowId>",
        "rule": "non-empty row ids that exist in docs/team/M0-03/allowlist.json#/allowlistRows"
      },
      {
        "field": "model",
        "type": "object",
        "fields": [
          "provider",
          "modelId"
        ],
        "rule": "modelId must match the role modelScope allow list; a role without model scope uses modelId none"
      },
      {
        "field": "acceptance",
        "type": "array<string>",
        "rule": "non-empty; the work order acceptance entries or JSON pointers to them"
      },
      {
        "field": "evidencePaths",
        "type": "array<repoPath>",
        "rule": "non-empty; every path lies inside writeScope"
      }
    ],
    "optional": [
      {
        "field": "orchestrator",
        "type": "enum",
        "values": [
          "pi",
          "direct-client",
          "none"
        ],
        "default": "none",
        "rule": "Pi is optional; no required field, transition or tool row depends on it"
      },
      {
        "field": "readScope",
        "type": "array<repoPath>"
      },
      {
        "field": "egressApprovals",
        "type": "array<approvalOwner>",
        "rule": "approval owners recorded for this session, e.g. APR-EGRESS"
      },
      {
        "field": "leaseRequests",
        "type": "array<resourceRef>",
        "rule": "resources the session intends to lease; each must be covered by writeScope or be a Unity project, editor or generated-output resource of the same workspace"
      }
    ],
    "forbiddenFields": [
      "assignee",
      "person",
      "personName",
      "teammate",
      "email",
      "hostname",
      "accountName"
