  "lease": {
    "fields": [
      {
        "field": "leaseId",
        "type": "token"
      },
      {
        "field": "resource",
        "type": "object",
        "fields": [
          "kind",
          "workspaceId",
          "path|root|editorInstanceId"
        ]
      },
      {
        "field": "holder",
        "type": "sessionId",
        "alignsWith": "work_graph.mjs lease.owner"
      },
      {
        "field": "baseRef",
        "type": "sha40",
        "alignsWith": "work_graph.mjs lease.baseSourceRef"
      },
      {
        "field": "acquiredAt",
        "type": "ISO-8601 UTC"
      },
      {
        "field": "expiresAt",
        "type": "ISO-8601 UTC",
        "rule": "later than acquiredAt and at most maxTtlSeconds after it"
      },
      {
        "field": "fence",
        "type": "integer",
        "rule": "strictly increasing per resource key; every write presents it and a stale fence is refused",
        "alignsWith": "work_graph.mjs lease.fence"
      },
      {
        "field": "baseContentSha256",
        "type": "sha256",
        "rule": "content digest of the leased resource at acquisition; crash recovery compares against it"
      },
      {
        "field": "state",
        "type": "enum",
        "valuesFrom": "/states"
      }
    ],
    "resourceKinds": [
      {
        "kind": "workspace-file",
        "keyTemplate": "workspace-file:{workspaceId}:{path}",
        "overlapRule": "same workspace and the paths are equal or one is a directory prefix of the other"
      },
      {
        "kind": "generated-output",
        "keyTemplate": "generated-output:{workspaceId}:{root}",
        "overlapRule": "same workspace and roots overlap by prefix; also overlaps any workspace-file lease under the root"
      },
      {
        "kind": "project-settings",
        "keyTemplate": "project-settings:{workspaceId}",
        "overlapRule": "same workspace; also overlaps any workspace-file lease under ProjectSettings/"
      },
      {
        "kind": "unity-project",
        "keyTemplate": "unity-project:{workspaceId}",
        "overlapRule": "same workspace; one Unity writer per project instance, so it also overlaps generated-output and project-settings leases of that workspace"
      },
      {
        "kind": "unity-editor",
        "keyTemplate": "unity-editor:{editorInstanceId}",
        "overlapRule": "same editor instance"
      }
    ],
    "limits": {
      "maxTtlSeconds": 3600
    },
    "blockingStates": [
      "active",
      "expired",
      "crash_suspected",
      "failed"
    ],
    "blockingRule": "An expired, crash-suspected or failed lease still blocks its resource until the PM recovers it; only released and recovered leases free the resource."
  },
  "states": [
    "active",
    "released",
    "expired",
    "crash_suspected",
    "recovered",
    "failed"
  ],
  "terminalStates": [
    "released",
    "recovered",
    "failed"
  ],
  "transitions": [
    {
      "id": "T-acquire",
      "from": null,
      "event": "acquire",
      "to": "active",
      "guards": [
        "holder, baseRef, expiresAt and baseContentSha256 are recordable",
        "expiresAt within maxTtlSeconds",
        "no lease in a blocking state overlaps the resource"
      ],
      "onReject": {
        "to": "rejected_attempt",
        "record": [
          "requester",
          "requestedResource",
          "reason",
          "conflictingLeaseId",
          "conflictingHolder",
          "conflictingScope",
          "conflictingBaseRef"
        ],
        "preserves": [
          "holder",
          "baseRef"
        ]
      }
    },
    {
      "id": "T-renew",
      "from": "active",
      "event": "renew",
      "to": "active",
      "guards": [
        "caller is holder",
        "fence is current",
        "now is before expiresAt",
        "new expiresAt within maxTtlSeconds of now"
      ],
      "onReject": {
        "to": "active",
        "record": [
          "caller",
          "reason"
        ],
        "preserves": [
          "holder",
          "baseRef",
          "fence",
          "expiresAt"
        ]
      }
    },
    {
      "id": "T-write",
      "from": "active",
      "event": "write",
      "to": "active",
      "guards": [
        "caller is holder",
        "fence is current",
        "now is before expiresAt",
        "path inside the leased resource"
      ],
      "onReject": {
        "to": "active",
        "record": [
          "caller",
          "presentedFence",
          "path",
          "reason"
        ],
        "preserves": [
          "holder",
          "baseRef",
          "fence"
        ]
      }
    },
    {
      "id": "T-release",
      "from": "active",
      "event": "release",
      "to": "released",
      "guards": [
        "caller is holder",
        "fence is current"
      ],
      "onReject": {
        "to": "active",
        "record": [
          "caller",
          "reason"
        ],
        "preserves": [
          "holder",
          "baseRef",
          "fence"
        ]
      },
      "preserves": [
        "holder",
        "baseRef",
        "fence",
        "resource"
      ]
    },
    {
      "id": "T-handoff",
      "from": "active",
      "event": "handoff",
      "to": "released",
      "guards": [
        "caller is holder",
        "fence is current",
        "handoff record names nextSessionId, outputs, tests and known limits"
      ],
      "onReject": {
        "to": "active",
        "record": [
          "caller",
          "reason"
        ],
        "preserves": [
          "holder",
          "baseRef",
          "fence"
        ]
      },
      "preserves": [
        "holder",
        "baseRef",
        "fence",
        "resource",
        "handoff"
      ],
      "note": "The next session still performs T-acquire; the handoff record never transfers the lease implicitly."
    },
    {
      "id": "T-expire",
      "from": "active",
      "event": "expire",
      "to": "expired",
      "guards": [
        "now is at or after expiresAt"
      ],
      "preserves": [
        "holder",
        "baseRef",
        "fence",
        "resource",
        "expiresAt"
      ]
    },
    {
      "id": "T-crash",
      "from": "active",
      "event": "crash_detected",
      "to": "crash_suspected",
      "guards": [
        "the holder session exit or loss is reported"
      ],
      "preserves": [
        "holder",
        "baseRef",
        "fence",
        "resource"
      ]
    },
    {
      "id": "T-recover",
      "from": [
        "expired",
        "crash_suspected"
      ],
      "event": "recover",
      "to": "recovered",
      "guards": [
        "caller role is role:pm",
        "current resource content sha256 equals baseContentSha256 or the last content digest recorded by an authorized write"
      ],
      "onReject": {
        "to": "failed",
        "whenReason": "content_changed_since_last_authorized_write",
        "record": [
          "caller",
          "expectedSha256",
          "observedSha256",
          "reason"
        ],
        "preserves": [
          "holder",
          "baseRef",
          "fence",
          "resource"
        ]
      },
      "onRejectOther": {
        "to": "unchanged",
        "whenReason": "caller_not_pm",
        "record": [
          "caller",
          "reason"
        ]
      },
      "preserves": [
        "holder",
        "baseRef",
        "fence",
        "resource"
      ],
      "note": "Recovery closes the old lease; a new session must T-acquire and receives fence + 1."
    }
  ],
