{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:wire:EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidenceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "subjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "testId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "testRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runEnvironmentRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "outputRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "result": {
      "enum": [
        "NOT_RUN",
        "FAILED",
        "PASSED_WITH_SCOPE",
        "INCONCLUSIVE"
      ]
    },
    "executedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "executorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reviewerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "notRunReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "evidenceId",
    "subjectRef",
    "testId",
    "testRevision",
    "runEnvironmentRef",
    "inputRefs",
    "outputRefs",
    "result",
    "executedAt",
    "executorId",
    "reviewerId",
    "claimScope",
    "notRunReason"
  ]
}
