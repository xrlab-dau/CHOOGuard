{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:wire:Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checkpointId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "cutSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "tickUs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "coreStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "eventQueueRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "randomStreamsRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "contentLockRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "requiredWorkers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "workerStates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "cutSequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "tickUs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mode": {
            "enum": [
              "FULL_STATE",
              "CHECKPOINT_REPLAY",
              "FROM_ORIGIN"
            ]
          },
          "stateOrRecipeRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ]
          },
          "replayEvidenceRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ]
          }
        },
        "required": [
          "workerId",
          "cutSequence",
          "tickUs",
          "inputDigest",
          "mode",
          "stateOrRecipeRef",
          "replayEvidenceRef"
        ]
      },
      "minItems": 0,
      "maxItems": 4096
    }
  },
  "required": [
    "checkpointId",
    "runId",
    "cutSequence",
    "tickUs",
    "coreStateRef",
    "eventQueueRef",
    "randomStreamsRef",
    "contentLockRef",
    "requiredWorkers",
    "workerStates"
  ]
}
