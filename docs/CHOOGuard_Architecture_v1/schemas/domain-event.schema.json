{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:architecture:domain-event:1.0.0",
  "title": "domain-event",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "simulationTicks": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "clockProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "microstep": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "causationId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previousEventHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payloadRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "SYNTHETIC_FIXTURE",
        "PROJECT_DATA"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "runId",
    "seq",
    "simulationTicks",
    "clockProfileId",
    "microstep",
    "kind",
    "causationId",
    "correlationId",
    "payloadHash",
    "previousEventHash",
    "eventHash",
    "payloadRef",
    "dataClass"
  ],
  "additionalProperties": false
}
