{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:architecture:command-intent:1.0.0",
  "title": "command-intent",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "intentId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "requesterId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "actingAgencyId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "actingTeamIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "action": {
      "type": "string",
      "enum": [
        "REQUEST_SUPPORT",
        "ASSIGN_TASK",
        "CANCEL_TASK",
        "ACKNOWLEDGE_MESSAGE",
        "PAUSE",
        "RESUME"
      ]
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "expected": {
      "type": "object",
      "properties": {
        "planRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ruleHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorityRevision": {
          "type": "integer",
          "minimum": 0
        },
        "targetRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "planRevision",
        "ruleHash",
        "authorityRevision",
        "targetRevision"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "taskId",
        "resourceIds"
      ],
      "additionalProperties": false
    },
    "batchPolicy": {
      "type": "string",
      "enum": [
        "ATOMIC_TASK",
        "INDEPENDENT_TASKS_WITH_PER_TASK_RECEIPTS"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "SYNTHETIC_FIXTURE",
        "PROJECT_DATA"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "intentId",
    "runId",
    "requesterId",
    "actingAgencyId",
    "actingTeamIds",
    "action",
    "targetId",
    "expected",
    "payload",
    "batchPolicy",
    "createdAt",
    "dataClass"
  ],
  "additionalProperties": false
}
