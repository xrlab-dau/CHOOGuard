FEATURES [label="응용 모듈\nOPS · CONTENT · EXPERIMENT\nAUTHOR · EVIDENCE", shape=box, style="rounded,filled", fillcolor="#EFF3F8", color="#496A8C", fontcolor="#18314A"];
SIM [label="SimulationCoordinator", shape=box, style="rounded,filled", fillcolor="#EFF3F8", color="#496A8C", fontcolor="#18314A"];
ADAPTERS [label="외부 구현 Adapter\nSTORE · WORKERS · AI · LEGACY", shape=box, style="rounded,filled", fillcolor="#F1ECF8", color="#77549A", fontcolor="#18314A"];
PORTS [label="ApplicationPorts\n저장 · 계산 · 검색 · 출력 인터페이스", shape=box, style="rounded,filled", fillcolor="#EFF3F8", color="#496A8C", fontcolor="#18314A"];
DOMAIN [label="DomainContracts\nID · DTO · 수량 · 규칙 AST", shape=box, style="rounded,filled", fillcolor="#EEF3E8", color="#647C41", fontcolor="#18314A"];
BOOT -> UI [label="조립 참조"];
