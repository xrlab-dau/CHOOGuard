RUN [label="Run\n고정 inputHash · parent cutoff", shape=box, style="rounded,filled", fillcolor="#EFF3F8", color="#496A8C", fontcolor="#18314A"];
EV [label="Event / Receipt / Hold\n기록·결정·예약", shape=cylinder, style="rounded,filled", fillcolor="#F4F0E6", color="#967A40", fontcolor="#18314A"];
CP [label="Checkpoint / Artifacts\n완전 상태·blob hash", shape=cylinder, style="rounded,filled", fillcolor="#F4F0E6", color="#967A40", fontcolor="#18314A"];
COM [label="Comparison\n같은 조건·QoI", shape=box, style="rounded,filled", fillcolor="#EFF3F8", color="#496A8C", fontcolor="#18314A"];
SCRIPT [label="ScriptIRRevision\n계획 + 대표 실행", shape=box, style="rounded,filled", fillcolor="#E7F1EF", color="#3D7E70", fontcolor="#18314A"];
REV [label="Evidence / Review\nsubject hash · facet · scope", shape=box, style="rounded,filled", fillcolor="#EEF3E8", color="#647C41", fontcolor="#18314A"];
SITE -> RUN [label="pinned input"];
