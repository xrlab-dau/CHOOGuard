      "@id": "cg:AT-058",
      "@type": "cg:AcceptanceTest",
      "label": "세션·저장·수동 편집은 유지되고 실패·비용을 기록한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-059",
      "@type": "cg:AcceptanceTest",
      "label": "자료를 권한/실행 코드/승인으로 처리하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-060",
      "@type": "cg:AcceptanceTest",
      "label": "안정 ID와 대상·시기·버전으로 구별하고 참조 무결성을 검사한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-061",
      "@type": "cg:AcceptanceTest",
      "label": "필수 입력/guard/상태가 빠지지 않고 미구현 파일을 실행 가능한 것으로 제시하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-062",
      "@type": "cg:AcceptanceTest",
      "label": "확인 범위·hash·대상·다음 행동을 보존하고 URL을 원본 보유로 계산하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-063",
      "@type": "cg:AcceptanceTest",
      "label": "과거 해시와 대조하고 다른 역 자료/실행파일/단위 오류를 탐지한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-064",
      "@type": "cg:AcceptanceTest",
      "label": "실제 포함물·제한·단위·참조·성능을 검사하고 이름/외형으로 능력·정원을 생성하지 않으며 유료팩을 필수 선행으로 넣지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-065",
      "@type": "cg:AcceptanceTest",
      "label": "운영 인원·실제 조작자·연기자를 구분하고 편집시간을 작업시간으로 쓰지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-066",
      "@type": "cg:AcceptanceTest",
      "label": "정확 경로·입력·겹침을 확인하고 VR/기존 이슈/타인작업을 무단 확장·중단하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-067",
      "@type": "cg:AcceptanceTest",
      "label": "동작 성공만으로 현장용 자격을 부여하지 않고 해당 gate만 보류한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-068",
      "@type": "cg:AcceptanceTest",
      "label": "실행 전 승인 계약과 독립 split 없으면 합격하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-069",
      "@type": "cg:AcceptanceTest",
      "label": "초기 구축·검수·출력 수정·도움까지 포함한 측정과 미완료를 분리하고 사전 계획 없이 생성속도만으로 절감·학습효과를 승인하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-070",
      "@type": "cg:AcceptanceTest",
      "label": "UI·렌더·물리·LLM 시간을 나누고 수치모델/인원을 몰래 줄이지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-071",
      "@type": "cg:AcceptanceTest",
      "label": "승인된 범위의 durable event를 복원하고 부족분은 누락으로 표시한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-072",
      "@type": "cg:AcceptanceTest",
      "label": "색만으로 의미를 전달하지 않고 한국어 용어와 원 의미를 연결한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-073",
      "@type": "cg:AcceptanceTest",
      "label": "최소수집·익명화·보관·반출 정책을 적용하고 승인 없는 결제/공유를 하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-074",
      "@type": "cg:AcceptanceTest",
      "label": "동일조건과 원시로그를 보존하고 무한 문서 수정으로 PASS를 만들지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-075",
      "@type": "cg:AcceptanceTest",
      "label": "같은 gate를 재적용하고 새 조건에 기존 정확도를 자동 상속하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-076",
      "@type": "cg:AcceptanceTest",
      "label": "장소·시기·범위·모델·규칙·불확도·승인주체·한계를 포함한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-077",
      "@type": "cg:AcceptanceTest",
      "label": "기억·문서·관찰 근거, 역할 중복, 사용 빈도·현재 도구·승인 경로의 미확인을 기록하고 가상 페르소나를 실측값으로 쓰지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-078",
      "@type": "cg:AcceptanceTest",
      "label": "실증만 미승인으로 두고 필수 입력·담당 역할·대체경로·막힌 주장을 반환하며 독립 코어 개발을 전역 중단하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-079",
      "@type": "cg:AcceptanceTest",
      "label": "동일인의 구간은 합집합으로 계산하고 회의는 실제 참여자별로 합산하며 무인계산·회신대기를 인시에 더하지 않고 누락·추정·도움을 보존한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-080",
      "@type": "cg:AcceptanceTest",
      "label": "첫 구축과 정상 반복 비용을 모두 보여주고 순절감이 양수가 아니거나 재사용 빈도가 없으면 회수 성공·총시간 절감을 주장하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-081",
      "@type": "cg:AcceptanceTest",
      "label": "비교군은 연구 조건으로만 기록하고 제품 모드는 두 개로 유지하며 조건별 차이·오염·도움·검수 가림 여부를 보존한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-082",
      "@type": "cg:AcceptanceTest",
      "label": "전체 시도를 분모로 제시하고 조건부 완수시간과 실패를 분리하며 사후 임계값 변경·좋은 사용자만 선택을 금지하고 근거 부족은 INCONCLUSIVE로 반환한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-083",
      "@type": "cg:AcceptanceTest",
      "label": "원본을 변경하지 않고 새 운영안을 만들며 참조·권한·개정·가정의 유효성을 확인하고 변경분만 입력할 수 있다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-084",
      "@type": "cg:AcceptanceTest",
      "label": "dirty 파생물·승인을 표시하고 영향 범위를 입증 못하면 확대 재계산하며 원본 로그를 보존하고 전체 재실행 대비 지정 결과의 동등성을 검사한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-085",
      "@type": "cg:AcceptanceTest",
      "label": "중간 계산과 이벤트를 생략하지 않고 미래 정보 누출·timestep 임의 확대 없이 순차 실행과 동등한 상태를 만들며 미완계산은 대기로 표시한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-086",
      "@type": "cg:AcceptanceTest",
      "label": "지원 형식과 수동 reconciliation 한계를 표시하고 의미변경은 운영안에 연결해 관련 승인을 무효화하며 출력후 수작업과 수정량을 기록한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-087",
      "@type": "cg:AcceptanceTest",
      "label": "허용된 기능을 유지하고 미지원 계산을 표시하며 승인 없는 업로드·외부 실행 없이 실패·비용·복구 기록을 남긴다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-088",
      "@type": "cg:AcceptanceTest",
      "label": "계약·관심·참여를 구분하고 훈련 참가자를 구매좌석으로 환산하지 않으며 반복 빈도·책임·미확인을 기록하되 학부 구현의 선행으로 구매계약을 요구하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-089",
      "@type": "cg:AcceptanceTest",
      "label": "가정·출처·모델범위·판본·검수상태를 표시하고 사용자가 미검증을 승인으로 오해하는지 측정하며 단일 녹색 점수로 자격을 통합하지 않는다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-090",
      "@type": "cg:AcceptanceTest",
      "label": "독립 개발과 제한된 효용시험은 열되 필수 미검증 QoI와 기관 승인·동기화·도입을 통과시키지 않고 NOT_APPLICABLE은 근거와 제한된 주장에만 사용한다",
      "status": "NOT_RUN"
    },
    {
      "@id": "cg:AT-091",
      "@type": "cg:AcceptanceTest",
      "label": "관측·공급자 주장·미확인을 구별하고 공개페이지에 없는 기능을 부재로 단정하지 않으며 설정 대 코어 변경·검수·지원비를 기록한다",
      "status": "NOT_RUN"
    },
