{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "asOf",
    "countMeaning",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "11.0.0"
    },
    "asOf": {
      "const": "2026-09-19"
    },
    "countMeaning": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "kind",
          "inspectionThisPRD",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string"
          },
          "inspectionThisPRD": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
