{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "scope",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "11.0.0"
    },
    "scope": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirementIds",
          "given",
          "when",
          "then",
          "level",
          "evidenceRequired",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AT-[0-9]{3}$"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string"
          },
          "evidenceRequired": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "result": {
            "const": "NOT_RUN"
          },
          "scopeLimit": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
