{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:wire:WorkerCapability",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "protocolVersion": {
      "const": "cg-worker/1"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "timeMode": {
      "enum": [
        "STEP",
        "BATCH"
      ]
    },
    "restartMode": {
      "enum": [
        "FULL_STATE",
        "CHECKPOINT_REPLAY",
        "FROM_ORIGIN",
        "NONE"
      ]
    },
    "validityProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "maxStepUs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "workerId",
    "modelRef",
    "protocolVersion",
    "fields",
    "timeMode",
    "restartMode",
    "validityProfileRef",
    "maxStepUs"
  ]
}
