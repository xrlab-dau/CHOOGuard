{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:wire:CommitReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "commitId",
    "revision",
    "intentReceipt",
    "dispatchableJobs"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "commitId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "intentReceipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:chooguard:wire:CommandReceipt",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "requesterId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "intentId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "runId",
            "requesterId",
            "intentId"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "CONFLICT"
          ]
        },
        "commitId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "targetResults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "targetId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "status": {
                "enum": [
                  "ACCEPTED",
                  "REJECTED",
                  "QUEUED"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "axis": {
                      "enum": [
                        "lifecycle",
                        "authority",
                        "knowledge",
                        "resources",
                        "mobility",
                        "safety",
                        "evidence"
                      ]
                    },
                    "subjectId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                          },
                          "revision": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "id",
                          "revision",
                          "sha256"
                        ]
                      },
                      "minItems": 0,
                      "maxItems": 4096
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    }
                  },
                  "required": [
                    "code",
                    "axis",
                    "subjectId",
                    "evidenceRefs",
                    "message"
                  ]
                },
                "minItems": 0,
                "maxItems": 4096
              }
            },
            "required": [
              "targetId",
              "status",
              "reasons"
            ]
          },
          "minItems": 1,
          "maxItems": 4096
        }
      },
      "required": [
        "key",
        "fingerprint",
        "status",
        "commitId",
        "sequence",
        "targetResults"
      ]
    },
    "dispatchableJobs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 4096
    }
  }
}
