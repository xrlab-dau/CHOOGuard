{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:wire:BranchRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "parentRunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "checkpointRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "newRunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "newPlanRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "requestedKind": {
      "enum": [
        "EXACT_FORK",
        "REEXECUTE_FROM_ORIGIN"
      ]
    }
  },
  "required": [
    "intentId",
    "parentRunId",
    "checkpointRef",
    "newRunId",
    "newPlanRef",
    "requestedKind"
  ]
}
