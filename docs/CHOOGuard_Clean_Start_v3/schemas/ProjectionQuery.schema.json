{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chooguard:wire:ProjectionQuery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "requesterId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "viewScope": {
      "enum": [
        "AUTHOR_ANALYSIS",
        "AGENCY_KNOWLEDGE"
      ]
    },
    "agencyId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "afterRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "runId",
    "requesterId",
    "viewScope",
    "agencyId",
    "afterRevision"
  ]
}
